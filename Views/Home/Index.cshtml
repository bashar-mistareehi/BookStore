@{
    Layout = null;
    ViewData["Title"] = "Welcome to BookVerse";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- استخدام روابط CDN مباشرة لضمان ظهور التصميم فوراً -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        body, html {
            height: 100%;
            margin: 0;
            font-family: 'Poppins', sans-serif;
            background-color: #1a1a1a; /* لون خلفية احتياطي في حال لم يعمل الفيديو */
        }

        .welcome-container {
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: white;
            position: relative;
            overflow: hidden;
        }

        /* تنسيق الفيديو ليكون خلفية كاملة */
        #bg-video {
            position: absolute;
            top: 50%;
            left: 50%;
            min-width: 100%;
            min-height: 100%;
            width: auto;
            height: auto;
            z-index: 0;
            transform: translateX(-50%) translateY(-50%);
            filter: brightness(0.3); /* تعتيم قوي ليظهر النص بوضوح */
        }

        .content {
            position: relative;
            z-index: 2;
            max-width: 800px;
            padding: 20px;
        }

        .btn-custom {
            padding: 15px 45px;
            border-radius: 50px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.3s ease;
        }

        .btn-login {
            background-color: #007bff;
            border: none;
            color: white;
        }

            .btn-login:hover {
                background-color: #0056b3;
                transform: translateY(-3px);
                box-shadow: 0 10px 20px rgba(0,123,255,0.3);
            }

        .btn-register {
            border: 2px solid white;
            color: white;
            background: transparent;
        }

            .btn-register:hover {
                background-color: white;
                color: black;
                transform: translateY(-3px);
            }

        h1 {
            font-size: 4rem;
            text-shadow: 2px 2px 10px rgba(0,0,0,0.5);
        }
    </style>
</head>
<body>

    <div class="welcome-container">
        <!-- الفيديو - تأكد من وجود الملف في wwwroot/videos/books-intro.mp4 -->
        <video autoplay muted loop playsinline id="bg-video">
            <source src="/videos/books-intro.mp4" type="video/mp4">
        </video>

        <div class="content">
            <h1 class="fw-bold mb-4">BookVerse</h1>
            <p class="lead mb-5 fs-3 opacity-90">Your gateway to infinite stories and knowledge. Discover your next favorite book today.</p>

            <div class="d-flex flex-column flex-sm-row justify-content-center gap-4">
                <a href="/Account/Login" class="btn btn-custom btn-login shadow-lg">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Login
                </a>
                <a href="/Account/Register" class="btn btn-custom btn-register shadow-lg">
                    <i class="bi bi-person-plus me-2"></i> Register
                </a>
            </div>

            <div class="mt-5 pt-4">
                <span class="badge rounded-pill bg-light text-dark px-3 py-2 opacity-75">Premium Bookstore Experience</span>
            </div>
        </div>
    </div>

</body>
</html>