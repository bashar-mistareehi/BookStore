@model BookStore.Models.Book

@{
    ViewData["Title"] = Model.Title;
}

@section Styles {
    <link rel="stylesheet" href="~/css/BookDetails-Style.css" />
}

<div class="container mt-4">
    <!-- رابط بسيط للعودة -->
    <a asp-action="Index" class="text-decoration-none text-muted small mb-4 d-inline-block">
        <i class="bi bi-arrow-left"></i> Back to Catalog
    </a>

    <div class="row g-4">
        <!-- قسم الصورة (تم تصغيره) -->
        <div class="col-md-4 text-center">
            <div class="book-img-container">
                @if (!string.IsNullOrEmpty(Model.BookImage))
                {
                    <img src="@Model.BookImage" class="book-detail-img" alt="@Model.Title">
                }
                else
                {
                    <img src="~/images/BookNoImage.png" class="book-detail-img" style="width: 300px; height: 180px; object-position:center top" alt="No Image">
                }
            </div>
        </div>

        <!-- قسم المعلومات (أحجام متناسقة) -->
        <div class="col-md-8">
            <div class="mb-2">
                <span class="badge bg-light text-primary border">@Model.Category.Name</span>
            </div>

            <h2 class="fw-bold mb-1">@Model.Title</h2>
            <p class="text-muted">By @Model.Author</p>

            <hr class="my-3">

            <div class="mb-4">
                <div class="info-label">Description</div>
                <p class="text-secondary" style="font-size: 0.95rem; text-align: justify;">
                    @Model.Description
                </p>
            </div>

            <div class="row mb-4">
                <div class="col-6 col-md-3">
                    <div class="info-label">Price</div>
                    <div class="price-text">@Model.Price.ToString() <small class="fw-normal" style="font-size: 0.9rem;">JD</small></div>
                </div>
                <div class="col-6 col-md-3 text-center text-md-start">
                    <div class="info-label">Stock</div>
                    @if (Model.Quantity > 0)
                    {
                        <span class="text-success small"><i class="bi bi-check-circle"></i> Available</span>
                    }
                    else
                    {
                        <span class="text-danger small"><i class="bi bi-x-circle"></i> Out of Stock</span>
                    }
                </div>
            </div>

            <!-- أزرار بسيطة -->
            <div class="d-flex gap-2">
                <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@Model.BookId"
                   class="btn btn-primary px-4 @(Model.Quantity) == 0 ? "disabled" : "")">
                    <i class="bi bi-cart-plus"></i> Add to Cart
                </a>
                <button class="btn btn-outline-secondary px-3">
                    <i class="bi bi-heart"></i>
                    </a>
            </div>
        </div>
    </div>
</div>