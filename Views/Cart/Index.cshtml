@model IEnumerable<CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container mt-5">
    <h2 class="fw-bold mb-4"><i class="bi bi-cart3"></i> Your Shopping Cart</h2>

    @if (!Model.Any())
    {
        <div class="text-center py-5 shadow-sm bg-light rounded">
            <i class="bi bi-cart-x text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3">Your cart is empty</h4>
            <p class="text-muted">Looks like you haven't added any books yet.</p>
            <a asp-controller="Books" asp-action="Index" class="btn btn-primary rounded-pill px-4">Start Shopping</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- قائمة المنتجات -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3">Book</th>
                                    <th>Price</th>
                                    <th>Quantity</th>
                                    <th>Total</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center p-2">
                                                <img src="@item.Image" class="rounded me-3" style="width: 80px; height: 70px; object-fit: cover;" alt="@item.Title">
                                                <div class="fw-bold">@item.Title</div>
                                            </div>
                                        </td>
                                        <td>@item.Price.ToString("0.00") JD</td>
                                        <td>
                                            <span class="badge bg-white text-dark border px-3 py-2">@item.Quantity</span>
                                        </td>
                                        <td class="fw-bold">@item.Total.ToString("0.00") JD</td>
                                        <td class="text-end pe-3">
                                            <a asp-action="RemoveFromCart" asp-route-id="@item.BookId" class="text-danger">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ملخص الطلب -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm p-4">
                    <h5 class="fw-bold mb-4">Order Summary</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal</span>
                        <span>@Model.Sum(x => x.Total).ToString("0.00") JD</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Shipping</span>
                        <span class="text-success small">Free</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between mb-4">
                        <span class="fw-bold fs-5">Total</span>
                        <span class="fw-bold fs-5 text-primary">@Model.Sum(x => x.Total).ToString("0.00") JD</span>
                    </div>
                    <button class="btn btn-primary btn-lg w-100 rounded-pill mb-2">Checkout</button>
                    <a asp-controller="Books" asp-action="Index" class="btn btn-outline-secondary w-100 rounded-pill">Continue Shopping</a>
                </div>
            </div>
        </div>
    }
</div>