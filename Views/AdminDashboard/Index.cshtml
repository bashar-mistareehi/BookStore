
@{
    ViewData["Title"] = "Index";
}

<div class="container mt-4">
    <h2 class="mb-4">Admin Dashboard</h2>

    <div class="row">
        <!-- بطاقة إحصائية -->
        <div class="col-md-4">
            <div class="card bg-primary text-white mb-4 shadow border-0">
                <div class="card-body">
                    <h5>Total Books</h5>
                    <h3>@ViewBag.TotalBooks</h3>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="small text-white stretched-link" asp-controller="Books" asp-action="Index">View Details</a>
                </div>
            </div>
        </div>

        <!-- بطاقة تنبيه المخزن -->
        <div class="col-md-4">
            <div class="card bg-warning text-dark mb-4 shadow border-0">
                <div class="card-body">
                    <h5>Low Stock Items</h5>
                    <h3>@ViewBag.LowStock</h3>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="small text-dark stretched-link" href="#">Check Inventory</a>
                </div>
            </div>
        </div>
    </div>
</div>

