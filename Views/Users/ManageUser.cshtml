@model BookStore.Models.User

@{
    ViewData["Title"] = "Manage User";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


<h2>Manage Account for: @Model.UserName</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-primary text-white"> User Access</div>
            <div class="card-body">
                <form asp-action="UpdateRole" method="post">
                    <input type="hidden" name="id" value="@Model.UserId" />
                    <div class="form-group">
                        <label>Current Role:</label>
                        <select name="RoleId" class="form-control" asp-items="ViewBag.Roles"></select>
                    </div>
                    <div class="text-center">
                        <button type="submit" class="btn btn-primary mt-3">Update Role</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-danger text-white">Account Status (Block)</div>
            <div class="card-body text-center">
                <p>
                    Current Status:
                    <span class="badge @(Model.IsLocked ? "bg-danger" : "bg-success")">
                        @(Model.IsLocked ? "Bolcked" : "Active")
                    </span>
                </p>
                <form asp-action="ToggleLockout" asp-route-id="@Model.UserId" method="post">
                    <button type="submit" class="btn @(Model.IsLocked ? "btn-success" : "btn-warning")">
                        @(Model.IsLocked ? "Unbolck User" : "Bolck User")
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>